{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenSymbolicRules/Conformance/schemas/cases.schema.json",
  "title": "OSR v1 rewrite conformance suite",
  "type": "object",
  "required": ["osr_format", "suite", "ruleset", "source_digest", "semantics", "cases"],
  "additionalProperties": false,
  "properties": {
    "osr_format": {"type": "string", "pattern": "^1\\."},
    "suite": {"type": "string", "minLength": 1},
    "ruleset": {"type": "string", "description": "Rule-set file, relative to the suite file"},
    "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semantics": {
      "type": "object",
      "required": ["domain", "rules", "strategy", "matching", "fuel", "reference"],
      "properties": {
        "domain": {"enum": ["real", "complex", "boolean"]},
        "rules": {"type": "string"},
        "strategy": {"type": "string"},
        "matching": {"type": "string"},
        "fuel": {"type": "integer", "minimum": 1},
        "reference": {"type": "string"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "profile", "input", "expected", "trace", "normal"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "profile": {"type": "string", "minLength": 1},
          "input": {"$ref": "#/$defs/om"},
          "expected": {"$ref": "#/$defs/om"},
          "trace": {"type": "array", "items": {"type": "string"}},
          "normal": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "oms": {
      "type": "object",
      "required": ["kind", "cd", "name"],
      "properties": {"kind": {"const": "OMS"}, "cd": {"type": "string"}, "name": {"type": "string"}}
    },
    "om": {
      "oneOf": [
        {"$ref": "#/$defs/oms"},
        {"type": "object", "required": ["kind", "name"],
         "properties": {"kind": {"const": "OMV"}, "name": {"type": "string"}}},
        {"type": "object", "required": ["kind", "integer"],
         "properties": {"kind": {"const": "OMI"}, "integer": {"type": "integer"}}},
        {"type": "object", "required": ["kind", "applicant", "arguments"],
         "properties": {"kind": {"const": "OMA"}, "applicant": {"$ref": "#/$defs/oms"},
           "arguments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/om"}}}}
      ]
    }
  }
}
