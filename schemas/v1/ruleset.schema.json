{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OpenSymbolicRules/Lean/schemas/ruleset.schema.json",
  "title": "OSR v1 rule set",
  "description": "A rule set exported from Lean-native OSR rules. Expressions use the OpenMath 2.0 JSON encoding (2019 revision, section 3.3), restricted to the OSR expression fragment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["osr_format", "ruleset", "expression_encoding", "build", "symbols", "profiles", "rules"],
  "properties": {
    "osr_format": { "const": "1.0.0-alpha.1" },
    "ruleset": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "expression_encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "cdbase"],
      "properties": {
        "standard": { "const": "OpenMath 2.0 JSON encoding (2019 revision, section 3.3)" },
        "cdbase": { "const": "http://www.openmath.org/cd" }
      }
    },
    "build": { "$ref": "#/$defs/build" },
    "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
    "profiles": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules"],
        "properties": {
          "rules": { "type": "array", "items": { "$ref": "#/$defs/rule_id" }, "uniqueItems": true }
        }
      }
    },
    "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "rule_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "assurance": { "enum": ["reviewed", "formally_related", "provisional", "unsupported"] },
    "domain": { "enum": ["real", "complex", "boolean"] },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "lean_toolchain", "mathlib_revision", "source_digest"],
      "properties": {
        "generator": { "type": "string" },
        "lean_toolchain": { "type": "string", "pattern": "^leanprover/lean4:v[0-9]+\\.[0-9]+\\.[0-9]+(-rc[0-9]+)?$" },
        "mathlib_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cd", "name", "uri", "arity", "fragment", "interpretations"],
      "properties": {
        "cd": { "type": "string" },
        "name": { "type": "string" },
        "uri": { "type": "string", "pattern": "^http://www\\.openmath\\.org/cd/[A-Za-z0-9_]+#[A-Za-z0-9_]+$" },
        "arity": { "type": "integer", "minimum": 0 },
        "fragment": { "type": "string" },
        "cd_version": { "type": "integer" },
        "cd_revision": { "type": "integer" },
        "cd_date": { "type": "string" },
        "cd_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "interpretations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "lean", "assurance", "definedness", "justification", "obligations", "unresolved"],
            "properties": {
              "domain": { "$ref": "#/$defs/domain" },
              "lean": { "type": "string" },
              "assurance": { "$ref": "#/$defs/assurance" },
              "definedness": { "type": "string" },
              "justification": { "type": "string" },
              "obligations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["cmp", "theorem", "note"],
                  "properties": {
                    "cmp": { "type": "string" },
                    "theorem": { "type": "string" },
                    "note": { "type": "string" }
                  }
                }
              },
              "unresolved": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "oms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cd", "name"],
      "properties": {
        "kind": { "const": "OMS" },
        "cd": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "omv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "OMV" },
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
      }
    },
    "omi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "integer"],
      "properties": {
        "kind": { "const": "OMI" },
        "integer": { "type": "integer" }
      }
    },
    "oma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "applicant", "arguments"],
      "properties": {
        "kind": { "const": "OMA" },
        "applicant": { "$ref": "#/$defs/oms" },
        "arguments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expr" } }
      }
    },
    "ombind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binder", "variables", "object"],
      "properties": {
        "kind": { "const": "OMBIND" },
        "binder": { "$ref": "#/$defs/oms" },
        "variables": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/omv" } },
        "object": { "$ref": "#/$defs/expr" }
      }
    },
    "expr": {
      "description": "The OSR expression fragment of OpenMath JSON: symbols, variables, integers, applications whose head is a symbol, and bindings (OMBIND, section 3.3.11) whose binder is a symbol.",
      "oneOf": [
        { "$ref": "#/$defs/oms" },
        { "$ref": "#/$defs/omv" },
        { "$ref": "#/$defs/omi" },
        { "$ref": "#/$defs/oma" },
        { "$ref": "#/$defs/ombind" }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "carrier", "status", "certified", "mapping_assurance", "prover",
                   "lean_toolchain", "mathlib_revision", "source_digest", "module", "axioms"],
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "carrier": { "$ref": "#/$defs/oms" },
        "status": { "enum": ["proved", "unproved", "counterexample", "unsupported", "generation_error"] },
        "certified": { "type": "boolean" },
        "mapping_assurance": { "$ref": "#/$defs/assurance" },
        "prover": { "const": "lean4" },
        "lean_toolchain": { "type": "string" },
        "mathlib_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_digest": { "$ref": "#/$defs/sha256" },
        "module": { "type": "string" },
        "theorem": { "type": "string" },
        "statement": { "type": "string" },
        "axioms": { "type": "array", "items": { "enum": ["propext", "Classical.choice", "Quot.sound"] } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "proved" } } },
          "then": { "required": ["theorem", "statement"] }
        },
        {
          "if": { "properties": { "certified": { "const": true } } },
          "then": {
            "properties": {
              "status": { "const": "proved" },
              "mapping_assurance": { "enum": ["reviewed", "formally_related"] }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "variables", "pattern", "replacement", "conditions",
                   "orientation", "applicability", "profiles", "priority", "symbols",
                   "provenance", "verification", "findings"],
      "properties": {
        "independent": {
          "description": "Matching constraints (v0.1 FreeQ): the subterm matched by `variable` must not mention the variable bound by the binder whose pattern variable is `of`.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["variable", "of"],
            "properties": { "variable": { "type": "string" }, "of": { "type": "string" } }
          }
        },
        "id": { "$ref": "#/$defs/rule_id" },
        "legacy_id": { "type": "string" },
        "description": { "type": "string" },
        "variables": { "type": "array", "items": { "$ref": "#/$defs/omv" } },
        "pattern": { "$ref": "#/$defs/expr" },
        "replacement": { "$ref": "#/$defs/expr" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/oma" } },
        "orientation": { "const": "forward" },
        "applicability": {
          "const": "defined_pattern",
          "description": "The rewrite is sound for every assignment satisfying the conditions under which the pattern is defined (all divisors nonzero, tan away from its poles, arctan away from its singularities)."
        },
        "profiles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "priority": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "sources"],
          "properties": {
            "method": { "enum": ["authored", "transcribed", "converted", "derived"] },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "locator"],
                "properties": {
                  "name": { "type": "string" },
                  "locator": { "type": "string" },
                  "revision": { "type": "string" },
                  "license": { "type": "string" }
                }
              }
            }
          }
        },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "findings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
